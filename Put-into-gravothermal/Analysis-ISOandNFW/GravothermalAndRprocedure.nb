Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hydroeq", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"M", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"tG", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t0", ",", "_Real"}], "}"}]}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{"Length", "@", "\[Rho]"}]}], ",", 
          RowBox[{"inv", "=", "\[Rho]"}], ",", 
          RowBox[{"\[Phi]", "=", "\[Rho]"}], ",", 
          RowBox[{"\[Psi]", "=", "\[Rho]"}], ",", 
          RowBox[{"a\[Phi]", "=", "\[Rho]"}], ",", 
          RowBox[{"b\[Phi]", "=", "\[Rho]"}], ",", 
          RowBox[{"c\[Phi]", "=", "\[Rho]"}], ",", 
          RowBox[{"d\[Phi]", "=", "\[Rho]"}], ",", 
          RowBox[{"a\[Psi]", "=", "\[Rho]"}], ",", 
          RowBox[{"b\[Psi]", "=", "\[Rho]"}], ",", 
          RowBox[{"c\[Psi]", "=", "\[Rho]"}], ",", 
          RowBox[{"d\[Psi]", "=", "\[Rho]"}], ",", 
          RowBox[{"\[Alpha]", "=", "\[Rho]"}], ",", 
          RowBox[{"\[Gamma]", "=", "\[Rho]"}], ",", 
          RowBox[{"\[Delta]r", "=", "\[Rho]"}], ",", 
          RowBox[{"\[Delta]\[Rho]", "=", "\[Rho]"}], ",", 
          RowBox[{"n\[Rho]", "=", "\[Rho]"}], ",", 
          RowBox[{"n\[Sigma]", "=", "\[Sigma]"}], ",", 
          RowBox[{"nr", "=", "r"}], ",", " ", 
          RowBox[{"index", " ", "=", " ", "\[Rho]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"index", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "k"}], ";", 
            RowBox[{"(*", 
             RowBox[{"I", " ", "ADDED", " ", "BY", " ", "KRZYSZTOF"}], "*)"}],
             "\[IndentingNewLine]", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"inv", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"n\[Sigma]", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], ")"}], "^", "3"}], "/", 
                RowBox[{"n\[Rho]", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Phi]", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"n\[Rho]", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"5", "/", "3"}], ")"}]}], " ", 
                    RowBox[{
                    RowBox[{"inv", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"2", "/", "3"}], ")"}]}]}], "-", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"n\[Rho]", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"5", "/", "3"}], ")"}]}], " ", 
                    RowBox[{
                    RowBox[{"inv", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"2", "/", "3"}], ")"}]}]}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"M", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", 
                   RowBox[{"M", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t0", "/", "tG"}], ")"}], "^", "2"}], " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"M", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", 
                    RowBox[{"M", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}]}], ")"}], 
                 "/", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", 
                   RowBox[{"\[Pi]", "^", "2"}], " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"nr", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", 
                    RowBox[{"nr", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}], "^", 
                    "4"}]}], ")"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "2", ",", "n"}], "}"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Psi]", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"M", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", 
                   RowBox[{"M", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"nr", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", 
                   RowBox[{"nr", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}]}], "-", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], " ", "\[Pi]", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"nr", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", 
                    RowBox[{"nr", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}], "^", 
                  "2"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"n\[Rho]", "[", 

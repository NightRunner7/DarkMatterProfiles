         RowBox[{"i", "=", "NR"}]}], "]"}], "/", 
       RowBox[{"Subscript", "[", 
        RowBox[{"r", ",", "0"}], "]"}]}], "]"}], "*)"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"NR", "=", "400"}], ";"}], " ", 
